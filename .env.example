# 四类服务独立配置。URL、模型及密钥必须由已有服务配置填写。
CHAT_BASE_URL=https://chat-provider.example/v1
CHAT_API_KEY=replace-with-chat-key
CHAT_MODEL=replace-with-purchased-chat-model
CHAT_CONTEXT_WINDOW=1048576
CHAT_MAX_OUTPUT_TOKENS=1800
CONTEXT_SAFETY_TOKENS=1024
CONTEXT_KEEP_TURNS=2
TOOL_RESULT_MAX_CHARS=8000
# 智能推理同轮连续搜索的并发上限；1 表示串行。
SEARCH_KNOWLEDGE_CONCURRENCY=4
# 默认扫描项目 skills/ 的直接子目录；也可登记具体技能目录，覆盖值使用 JSON 绝对路径列表。
# SKILL_DIRS=["/absolute/project/skills"]
EMBED_BASE_URL=https://embedding-provider.example/v1
EMBED_API_KEY=replace-with-embedding-key
EMBED_MODEL=replace-with-purchased-embedding-model
# 首次真实探活后填写，不凭模型名称猜测。
# EMBED_DIMENSION=
RERANK_URL=https://rerank-provider.example/full-endpoint
RERANK_API_KEY=replace-with-rerank-key
RERANK_MODEL=replace-with-purchased-rerank-model
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_KEY=replace-with-mineru-key
MINERU_MODEL=vlm
LANGFUSE_BASE_URL=http://127.0.0.1:3010
LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key

CHAT_CONNECT_TIMEOUT=10
CHAT_READ_TIMEOUT=120
CHAT_WRITE_TIMEOUT=60
CHAT_POOL_TIMEOUT=10
EMBED_CONNECT_TIMEOUT=10
EMBED_READ_TIMEOUT=120
EMBED_WRITE_TIMEOUT=60
EMBED_POOL_TIMEOUT=10
RERANK_CONNECT_TIMEOUT=10
RERANK_READ_TIMEOUT=120
RERANK_WRITE_TIMEOUT=60
RERANK_POOL_TIMEOUT=10
MINERU_CONNECT_TIMEOUT=10
MINERU_READ_TIMEOUT=120
MINERU_WRITE_TIMEOUT=60
MINERU_POOL_TIMEOUT=10
MINERU_POLL_INTERVAL=3
MINERU_POLL_TIMEOUT=600
LANGFUSE_QUERY_TIMEOUT=60
CHAT_PROBE_MAX_TOKENS=256
CHAT_PROBE_ENABLE_THINKING=false

# 本项目业务存储与认证，真实秘密仅放本地 .env
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3316
MYSQL_DATABASE=kb
MYSQL_USER=kb
MYSQL_PASSWORD=replace-with-project-mysql-password
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=replace-with-project-redis-password
REDIS_DB=0
MILVUS_URI=http://127.0.0.1:19540
MILVUS_COLLECTION=personal_knora_chunks
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password
JWT_SECRET=replace-with-random-secret
APP_ORIGIN=http://127.0.0.1:8000
COOKIE_SECURE=false
# 一次登录保持30天，JWT和Cookie使用同一有效期（秒）。
SESSION_TTL_SECONDS=2592000
INGEST_QUEUE=personal_knora_ingest
JOB_TIMEOUT=900
EMBED_BATCH_SIZE=16
# DATA_DIR 默认为项目根目录 DATA/runtime
# 外部MCP：只允许引用显式登记的凭据变量，不填写真实密钥。
MCP_DEMO_BEARER_TOKEN=
MCP_TAVILY_API_KEY=
MCP_OPERATION_TIMEOUT=30
MCP_CLEANUP_TIMEOUT=5

# 本地容器凭据由 bootstrap_local 生成。
MYSQL_ROOT_PASSWORD=replace-with-mysql-root-password
MINIO_ROOT_USER=knowledgebase
MINIO_ROOT_PASSWORD=replace-with-minio-password
